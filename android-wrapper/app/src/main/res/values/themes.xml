<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base dark theme -->
    <style name="Theme.MalaMusic" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#F43F5E</item>
        <item name="colorPrimaryContainer">#4C1D2B</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#A78BFA</item>
        <item name="android:colorBackground">#08090D</item>
        <item name="colorSurface">#121318</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="android:statusBarColor">#050507</item>
        <item name="android:navigationBarColor">#08090D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#08090D</item>
    </style>

    <!-- Splash theme with animated background -->
    <style name="Theme.MalaMusic.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">#050507</item>
        <item name="android:statusBarColor">#050507</item>
        <item name="android:navigationBarColor">#050507</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
