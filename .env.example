# MalaMusic production environment
# Copy these names into Vercel Project Settings > Environment Variables.
# Never commit real values to the repository.

NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Firebase Admin SDK. Use either the complete JSON value OR the split values below.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=heroikzre
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=https://heroikzre-default-rtdb.asia-southeast1.firebasedatabase.app

# Firebase Web API key used only by server-side password/OOB Auth calls.
FIREBASE_WEB_API_KEY=

# YouTube Music internal client key used by album, artist, and lyrics metadata endpoints.
YOUTUBE_MUSIC_API_KEY=

# Optional AssemblyAI key used only by the transcription fallback.
ASSEMBLYAI_API_KEY=

# Cloudflare Worker statistics integration.
MALAMUSIC_STATS_WORKER_URL=https://malamusic-stats.daffaheroik2020.workers.dev
MALAMUSIC_INTERNAL_SECRET=

# Vercel Cron authorization for the daily statistics rollover.
CRON_SECRET=

# Optional legacy Google OAuth route. The primary login flow is Firebase Auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_APP_ORIGIN=

# Optional legacy Resend values retained only if an email workflow is re-enabled.
RESEND_API_KEY=
RESEND_FROM=
