# Email OTP authentication via Resend
# Use a Resend API key with sending permission.
RESEND_API_KEY=your-resend-api-key
# Sender must use the verified domain malawalipayment.web.id.
RESEND_FROM=MalaMusic <otp@malawalipayment.web.id>
# Random 32+ character value used to sign session and OTP cookies.
SESSION_SECRET=replace-with-a-long-random-secret

# Optional legacy Google OAuth settings.
# These are no longer required for MalaMusic email login, but keep them only
# if YouTube liked-video synchronization is re-enabled later.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_APP_ORIGIN=
