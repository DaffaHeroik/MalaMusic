{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/__/auth/(.*)",
      "dest": "https://heroikzre.firebaseapp.com/__/auth/$1"
    },
    {
      "src": "/__/firebase/(.*)",
      "dest": "https://heroikzre.firebaseapp.com/__/firebase/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
